// 1. Prisma 클라이언트 및 DB 연결 설정
// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url 부분은 아예 지워버리세요.
}

// 2. 사용자 모델 (Supabase Auth user.id 와 동일한 UUID 문자열)
model User {
  id         String   @id // auth.users.id (Supabase)
  username   String   @unique
  email      String   @unique
  avatarUrl  String? // Cloudflare R2 등 퍼블릭 URL
  newsletterSubscribed Boolean @default(false)
  digestFrequency DigestFrequency @default(DAILY)
  /// USER · BUILDER · ADMIN — 공지 관리 등은 ADMIN 만 (세션·서버 액션에서 검증)
  role       Role     @default(USER)
  /// MBTI 16유형 (영문 4글자, 예: INTJ) — AI FORTUNE 카드 하이라이트용
  mbti       String?  @db.VarChar(4)
  posts      Post[]
  postLikes  PostLike[]
  bookmarks  Bookmark[]
  comments   Comment[]
  stances    PostStance[]
  passwordResetTokens PasswordResetToken[]
  gameScores GameScore[]
  juryMemberships JuryMembership[]
  juryServiceMembers JuryServiceMember[]
  juryInvitationsSent OrganizationInvitation[] @relation("JuryInvitationInviter")
  createdAt  DateTime @default(now())
}

/// 게임별 최고 점수 (주간 weekKey / 전체 "all")
model GameScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// catalog GameSlug: brickbreaking | minibrick
  gameSlug  String   @db.VarChar(64)
  /// brick: stage|infinite · mini: normal|endless
  mode      String   @db.VarChar(32)
  score     Int
  /// ISO week e.g. 2026-W29, or "all" for overall PB
  weekKey   String   @db.VarChar(16)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameSlug, mode, weekKey])
  @@index([gameSlug, mode, weekKey, score(sort: Desc)])
}

/// 비밀번호 찾기 메일의 `?token=` 검증용 (Supabase 메일의 redirect_to 에 포함)
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// 3. 게시물 모델 (4개의 복도 통합 관리)
model Post {
  id          String      @id @default(uuid())
  category    Category
  title       String
  content     String?
  thumbnail   String?
  /// 대표 썸네일 외 추가 미디어 URL (최대 4개 + thumbnail = 5개까지)
  attachmentUrls String[] @default([])
  /// 상세·피드 조회수
  views       Int         @default(0)
  /// 좋아요 수(비정규화). 실제 누른 유저는 `likes` 관계(PostLike)
  likeCount   Int         @default(0)
  /// 메인 상단 등 에디터 픽 노출용
  isFeatured  Boolean     @default(false)
  /// 메인 LAUNCH 배너 슬라이더 노출 (관리자 승인)
  featuredOnHome Boolean    @default(false)
  /// LAUNCH 배너 노출 만료 (null = 무기한)
  launchBannerUntil DateTime?
  /// 출시·외부 서비스 페이지 등 연결 URL (선택)
  externalLink String?
  /// GeekNews 크론 등 — 원문 URL로 중복 방지 (고유, 선택)
  geeknewsOriginalUrl String? @unique @db.VarChar(2048)
  /// Hacker News 크론 등 — 원문 URL로 중복 방지 (고유, 선택)
  hackerNewsOriginalUrl String? @unique @db.VarChar(2048)
  /// Lobsters RSS 크론 등 — 원문 URL로 중복 방지 (고유, 선택)
  lobstersOriginalUrl String? @unique @db.VarChar(2048)
  /// Techmeme RSS 크론 등 — 원문 URL로 중복 방지 (고유, 선택)
  techmemeOriginalUrl String? @unique @db.VarChar(2048)
  /// The Verge RSS 등 — 원문 URL로 중복 방지 (고유, 선택)
  vergeOriginalUrl String? @unique @db.VarChar(2048)
  /// AI Breakfast (Beehiiv) 등 — 원문 URL로 중복 방지 (고유, 선택)
  aiBreakfastOriginalUrl String? @unique @db.VarChar(2048)
  /// MIT News RSS 등 — 원문 URL로 중복 방지 (고유, 선택)
  mitNewsOriginalUrl String? @unique @db.VarChar(2048)
  /// AI FORTUNE 주간 운세 — 동일 주차 중복 방지 (고유, 선택) 예: 2026-05-W3
  aiFortuneWeekKey String? @unique @db.VarChar(32)
  /// AI FORTUNE 주간 리포트 구조화 JSON (트렌드·16 MBTI 운세)
  aiFortunePayload Json?
  /// YouTube 자동 요약 게시 — 영상 ID 중복 방지 (고유, 선택)
  youtubeVideoId String? @unique @db.VarChar(16)
  /// MIT_OCW | DEEPMIND — UI 배지·요약 스타일 구분
  youtubeSyndicationSource String? @db.VarChar(16)
  /// 해시태그 (#은 표시 시만 붙임)
  tags        String[]    @default([])
  /// 갤러리 이미지 역분석 — AI가 추정한 프롬프트 (캐시)
  aiReversePrompt String? @db.Text
  /// 갤러리 이미지 역분석 전체 JSON (Gemini 응답)
  aiImageAnalysis Json?
  /// 작성 주체 — HUMAN(UGC) / SYSTEM(크론·신디케이션) / AI(운세 등)
  authorKind  PostAuthorKind @default(HUMAN)
  author      User        @relation(fields: [authorId], references: [id])
  authorId    String
  metadata    AiMetadata?
  launchInfo  LaunchInfo?
  /// 좋아요를 누른 유저와의 관계 (PostLike)
  likes       PostLike[]
  bookmarks   Bookmark[]
  comments    Comment[]
  viewDaily   PostViewDaily[]
  stances     PostStance[]
  createdAt   DateTime    @default(now())

  @@index([category, createdAt(sort: Desc)])
  @@index([featuredOnHome, launchBannerUntil])
  @@index([authorKind, createdAt(sort: Desc)])
}

/// 사용자가 저장한 글 (상세의 북마크 버튼과 연동)
model Bookmark {
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([userId])
  @@index([postId])
}

// 게시글 좋아요 (누가 눌렀는지 추적, Post.likeCount와 동기화)
model PostLike {
  postId    String
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
  @@index([userId])
}

/// 게시글 상세 댓글 (작성자는 `User`, 로그인 유저만 POST API로 작성)
model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([authorId])
}

/// 일별 조회수 버킷 (viewsLast7d용). Post.views 누적과 병행.
model PostViewDaily {
  postId String
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  count  Int      @default(0)

  @@id([postId, day])
  @@index([day])
}

/// 게시글 동의/반박 (댓글 유도용)
model PostStance {
  postId    String
  userId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice    StanceChoice
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@id([postId, userId])
  @@index([postId, choice])
}

/// 댓글 알림 이메일 스로틀 (post 작성자 기준)
model CommentNotifyThrottle {
  postId     String
  authorId   String
  lastSentAt DateTime

  @@id([postId, authorId])
}

enum PostAuthorKind {
  HUMAN
  SYSTEM
  AI
}

enum StanceChoice {
  AGREE
  DISAGREE
}

// 4. AI 레시피 및 빌드 정보 (Lab/Build 복도용 상세 데이터)
model AiMetadata {
  postId      String  @id
  post        Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  modelName   String? // 예: GPT-4o, Midjourney
  prompt      String? @db.Text
  params      Json?   // Seed, Temp 등 설정을 JSON 형태로 저장
  /// `analyzePostPromptAnalysis` 결과 캐시 (프롬프트 지문과 함께만 유효)
  promptAnalysis           Json?
  promptAnalysisPromptHash String? @db.VarChar(64)
  /// 등록 직후 백그라운드 Gemini 분석 작업 상태 (null = 레거시·수동 분석만 해당)
  promptAnalysisStatus     PromptAnalysisJobStatus?
}

// 5. 서비스 홍보 정보 (Launchpad 복도용 상세 데이터)
model LaunchInfo {
  postId      String  @id
  post        Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  serviceUrl  String? // 서비스 바로가기 링크
  status      String? // BETA, LIVE 등 상태
}

/// LAB 프롬프트 자동 분석(등록 후 비동기) 작업 상태
enum PromptAnalysisJobStatus {
  PENDING
  READY
  FAILED
}

// 6. 열거형 데이터 (고정된 선택지)
enum Role {
  USER
  BUILDER
  ADMIN
}

enum DigestFrequency {
  DAILY
  WEEKLY
}

enum Category {
  RECIPE  // 프롬프트 복도 (LAB)
  GALLERY // 아트 복도
  LOUNGE  // 라운지 · 텍스트 중심 (썸네일 선택)
  GOSSIP  // 소셜·가십 복도
  BUILD   // 빌드 복도
  LAUNCH  // 서비스 복도
  TREND   // 레거시(구 테크 트렌드) — 신규 외부 뉴스는 LOUNGE
  AI_FORTUNE // AI 주간 운세·커리어 가이드 (자동 게시)
}

/// 관리자(BO)에서 수정 가능한 UI 카피 (메뉴·헤드라인·탭 등)
model UiConfig {
  key         String   @id
  value       String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 사이트 상단 롤링 공지 등
model Notice {
  id        String   @id @default(cuid())
  title     String
  /// 공지 본문 (상세 페이지 `/notices/[id]` 에 표시)
  content   String   @default("") @db.Text
  /// 선택: 본문 외 추가 이동 링크(외부·내부). 롤링 바는 항상 상세 페이지로만 연결
  link      String?
  /// 상단 롤링 바 노출 여부
  isRolling Boolean  @default(false)
  /// 높을수록 먼저 노출
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRolling, priority(sort: Desc), createdAt(sort: Desc)])
}

/// Jury product persistence. User.role is not a Jury role.
/// credentialRef is an external secret-store key, never a token or password.

enum JuryMemberRole {
  OWNER
  ADMIN
  REVIEWER
  DEVELOPER
  VIEWER
}

enum JuryServicePermission {
  VIEW
  REVIEW
  IMPROVE
  AGENT
}

enum JuryAccessMethod {
  OAUTH
  API_KEY
  READ_ONLY_ACCOUNT
  BROWSER_SESSION
  FILE_UPLOAD
}

enum JuryConnectionStatus {
  DRAFT
  CONNECTED
  DISCOVERY_PENDING
  LIMITED
  DISCONNECTED
  ERROR
}

enum JuryScopeStatus {
  PROPOSED
  APPROVED
  REVOKED
}

enum JuryDiscoveryFeasibility {
  AVAILABLE
  PARTIAL
  NOT_AVAILABLE
}

enum JuryApproval {
  PENDING
  APPROVED
  REJECTED
}

enum JuryMetricUnit {
  COUNT
  KRW
  PERCENT
  DURATION_SEC
  RATIO
  OTHER
}

enum JurySourceSystem {
  DATABASE
  GA4
  API
  SCREEN
  FILE
  OTHER
}

enum JuryAvailability {
  AVAILABLE
  NOT_MEASURED
  NOT_AVAILABLE
  PERMISSION_DENIED
  COLLECTION_FAILED
  UNSUPPORTED
}

enum JuryReviewType {
  CLAIM_VALIDATION
  FULL_REVIEW
  UI_UX_REVIEW
}

enum JuryReviewMode {
  AISLE_SELF
  EXTERNAL_SERVICE
}

enum JuryReviewStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum JuryEvidenceStrength {
  strong
  moderate
  unknown
}

enum JuryClaimStrength {
  weak
  strong
  extreme
}

enum JuryDecision {
  ACCEPT
  VERIFY
  REWORD
}

enum JuryDecisionTaskType {
  VERIFICATION
  REWORD
}

enum JuryDecisionTaskStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

enum JuryTaskStatus {
  OPEN
  HANDED_OFF
  GATED
  NEEDS_APPROVAL
  DONE
  STOPPED
}

enum JuryAgentKind {
  CURSOR
  CLAUDE_CODE
  MANUAL
  OTHER
}

enum JuryExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  BLOCKED
}

enum JuryGateResult {
  PASS
  NEEDS_APPROVAL
  BLOCK
}

enum JuryChangeGateStatus {
  GATED
  APPROVED
  BLOCKED
}

enum JuryChangeRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model JuryTenant {
  id           String   @id
  name         String
  createdAt    DateTime @default(now())
  memberships  JuryMembership[]
  connections  JuryServiceConnection[]
  scopes       JuryAccessScope[]
  discoveries  JuryDiscoveryResult[]
  metrics      JuryNormalizedMetric[]
  evidence     JuryEvidence[]
  requests     JuryReviewRequest[]
  results      JuryReviewResult[]
  tasks        JuryImprovementTask[]
  executions   JuryAgentExecution[]
  gates        JuryChangeGateResult[]
  changeGateResolutions JuryChangeGateResolution[]
  changeGateReviews JuryChangeGateReview[]
  reReviews    JuryReReviewResult[]
  audits       JuryAuditEvent[]
  decisionTasks JuryDecisionTask[]
  verificationResults JuryVerificationResult[]
  verificationReviews JuryVerificationReview[]
  productLoopPolicies JuryProductLoopPolicy[]
  decisionCycles JuryDecisionCycle[]
  autoLoopActivation JuryAutoLoopActivation?
  humanDecisions JuryHumanDecision[]
  serviceMembers JuryServiceMember[]
  invitations OrganizationInvitation[]
}

model JuryMembership {
  id        String         @id
  tenantId  String
  tenant    JuryTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  role      JuryMemberRole
  createdAt DateTime       @default(now())

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
}

model JuryServiceConnection {
  id               String               @id
  tenantId         String
  tenant           JuryTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceKey       String
  displayName      String
  accessMethod     JuryAccessMethod
  status           JuryConnectionStatus
  /// Pointer into a secret store. Not an OAuth token, API key, or password.
  credentialRef    String?
  createdByUserId  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  scopes           JuryAccessScope[]
  discoveries      JuryDiscoveryResult[]
  metrics          JuryNormalizedMetric[]
  evidence         JuryEvidence[]
  requests         JuryReviewRequest[]
  serviceMembers   JuryServiceMember[]

  @@index([tenantId])
}

model JuryServiceMember {
  id           String                @id
  tenantId     String
  tenant       JuryTenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String
  connection   JuryServiceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  permission   JuryServicePermission
  createdAt    DateTime              @default(now())

  @@unique([connectionId, userId, permission])
  @@index([tenantId])
  @@index([userId])
}

model OrganizationInvitation {
  id        String         @id
  tenantId  String
  tenant    JuryTenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  role      JuryMemberRole
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  invitedBy String
  inviter   User           @relation("JuryInvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([tenantId, email])
}

model JuryAccessScope {
  id               String          @id
  tenantId         String
  tenant           JuryTenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId     String
  connection       JuryServiceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  status           JuryScopeStatus
  grants           Json
  approvedByUserId String?
  approvedAt       DateTime?
  expiresAt        DateTime?

  @@index([tenantId])
}

model JuryDiscoveryResult {
  id              String                   @id
  tenantId        String
  tenant          JuryTenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      JuryServiceConnection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  exploredAt      DateTime
  surfaces        Json
  menus           Json
  dataSources     Json
  feasibility     JuryDiscoveryFeasibility
  proposedMetrics Json
  approval        JuryApproval
  uiNotes         String?

  @@index([tenantId])
}

model JuryEvidence {
  id           String                @id
  tenantId     String
  tenant       JuryTenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId String
  connection   JuryServiceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  purpose      String
  periodStart  String
  periodEnd    String
  timezone     String
  metricIds    Json
  apiEvidence  Json?
  uiEvidence   Json?
  documentEvidence Json?
  adapterKey   String
  collectedAt  DateTime
  contentHash  String?
  /// Copied from the source EvidencePack. Not inferred at read time.
  piiExcluded  Boolean
  readOnly     Boolean
  metrics      JuryNormalizedMetric[]
  requests     JuryReviewRequest[]
  decisionTasks JuryDecisionTask[]
  verificationResults JuryVerificationResult[]
  verificationReviews JuryVerificationReview[]
  improvementTasks JuryImprovementTask[]
  changeGateReviews JuryChangeGateReview[]

  @@unique([tenantId, connectionId, purpose, periodStart, periodEnd, timezone, contentHash], map: "JuryEvidence_identity_key")
  @@index([tenantId])
}

model JuryNormalizedMetric {
  id             String            @id
  tenantId       String
  tenant         JuryTenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId   String
  connection     JuryServiceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  evidenceId     String?
  evidence       JuryEvidence?     @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  metric         String
  /// Null when availability is not AVAILABLE. Zero stays zero.
  value          Float?
  unit           JuryMetricUnit
  periodStart    String
  periodEnd      String
  timezone       String
  sourceSystem   JurySourceSystem
  sourceRef      String
  collectedAt    DateTime
  availability   JuryAvailability
  rawValueText   String?
  rawPayloadRef  String
  adapterKey     String
  adapterVersion String
  ruleId         String

  @@index([tenantId])
}

model JuryReviewRequest {
  id            String           @id
  tenantId      String
  tenant        JuryTenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId  String
  connection    JuryServiceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  evidenceId    String
  evidence      JuryEvidence     @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  reviewType    JuryReviewType
  claim         String?
  mode          JuryReviewMode
  status        JuryReviewStatus
  coreRootDir   String
  requestedByUserId String?
  result        JuryReviewResult?
  humanDecision JuryHumanDecision?

  @@index([tenantId])
}

model JuryReviewResult {
  id                 String               @id
  tenantId           String
  tenant             JuryTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewRequestId    String               @unique
  request            JuryReviewRequest    @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)
  boardRunId         String
  evidenceStrength   JuryEvidenceStrength
  claimStrength      JuryClaimStrength
  conflictDetected   Boolean
  overclaimDetected  Boolean
  revisionRequired   Boolean
  expectedDecision   JuryDecision
  finalSurface       Json
  contractVersion    String
  completedAt        DateTime
  parentReviewResultId String?
  parentReviewResult   JuryReviewResult?  @relation("ReviewLineage", fields: [parentReviewResultId], references: [id], onDelete: Restrict)
  childReviews         JuryReviewResult[] @relation("ReviewLineage")
  verificationResultId String?
  verificationResult   JuryVerificationResult? @relation("VerificationChildReview", fields: [verificationResultId], references: [id], onDelete: Restrict)
  decisionTaskId       String?
  decisionTask         JuryDecisionTask?  @relation("DecisionTaskChildReview", fields: [decisionTaskId], references: [id], onDelete: Restrict)
  reReviewRequestId    String?            @unique
  reReviewRequest      JuryVerificationReview? @relation("VerificationReviewExecution", fields: [reReviewRequestId], references: [id], onDelete: Restrict)
  tasks              JuryImprovementTask[]
  decisionTasks      JuryDecisionTask[]
  verificationResults JuryVerificationResult[]
  verificationReviews JuryVerificationReview[] @relation("VerificationReviewParent")
  cycleRoot JuryDecisionCycle? @relation("CycleRoot")
  cycleCurrents JuryDecisionCycle[] @relation("CycleCurrent")
  changeGateReviews JuryChangeGateReview[] @relation("ChangeGateReviewParent")
  humanDecision JuryHumanDecision?

  @@index([tenantId])
}

/// Person's choice after reading a Jury result. It does not replace expectedDecision.
model JuryHumanDecision {
  id              String           @id
  tenantId        String
  tenant          JuryTenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewResultId  String           @unique
  reviewResult    JuryReviewResult @relation(fields: [reviewResultId], references: [id], onDelete: Restrict)
  reviewRequestId String           @unique
  reviewRequest   JuryReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Restrict)
  decision        JuryDecision
  actorUserId     String
  createdAt       DateTime

  @@unique([tenantId, reviewResultId], map: "JuryHumanDecision_tenant_review_key")
  @@index([tenantId])
}

model JuryImprovementTask {
  id                   String        @id
  tenantId             String
  tenant               JuryTenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewResultId       String
  reviewResult         JuryReviewResult @relation(fields: [reviewResultId], references: [id], onDelete: Cascade)
  diagnosis            String
  acceptanceCriteria   Json
  status               JuryTaskStatus
  loopIndex            Int
  loopPolicy           Json
  parentTaskId         String?
  stopReason           String?
  decisionTaskId       String?
  decisionTask         JuryDecisionTask? @relation(fields: [decisionTaskId], references: [id], onDelete: Restrict)
  evidenceId           String?
  evidence             JuryEvidence? @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  taskType             JuryDecisionTaskType?
  title                String?
  description          String?
  reason               String?
  objective            String?
  constraints          Json?
  provenance           Json?
  createdAt            DateTime?
  updatedAt            DateTime?
  executions           JuryAgentExecution[]
  reReviews            JuryReReviewResult[]
  changeGates          JuryChangeGateResult[]
  changeGateReviews    JuryChangeGateReview[]

  @@unique([decisionTaskId, taskType])
  @@index([tenantId])
}

/// Decision-to-task record. Separate from the agent-loop JuryImprovementTask.
model JuryDecisionTask {
  id             String                 @id
  tenantId       String
  tenant         JuryTenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviewResultId String
  reviewResult   JuryReviewResult       @relation(fields: [reviewResultId], references: [id], onDelete: Restrict)
  evidenceId     String
  evidence       JuryEvidence           @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  taskType       JuryDecisionTaskType
  decision       JuryDecision
  title          String
  description    String
  reason         String
  status         JuryDecisionTaskStatus
  createdAt      DateTime
  updatedAt      DateTime
  verificationResult JuryVerificationResult?
  verificationReviews JuryVerificationReview[]
  childReviews JuryReviewResult[] @relation("DecisionTaskChildReview")
  improvementTasks JuryImprovementTask[]

  @@unique([reviewResultId, taskType])
  @@index([tenantId])
}

enum JuryVerificationStatus {
  RESOLVED
  UNRESOLVED
  INCONCLUSIVE
}

enum JuryVerificationReviewStatus {
  PENDING
  READY
  RUNNING
  EXECUTED
  BLOCKED
  FAILED
}

enum JuryVerificationReviewType {
  VERIFICATION_REREVIEW
}

/// Stored verification of a decision task. It does not judge which source is correct.
model JuryVerificationResult {
  id               String                   @id
  tenantId         String
  tenant           JuryTenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisionTaskId   String                   @unique
  decisionTask     JuryDecisionTask         @relation(fields: [decisionTaskId], references: [id], onDelete: Restrict)
  reviewResultId   String
  reviewResult     JuryReviewResult         @relation(fields: [reviewResultId], references: [id], onDelete: Restrict)
  evidenceId       String
  evidence         JuryEvidence             @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  status           JuryVerificationStatus
  finding          String
  verificationGoal String
  provenance       Json
  fingerprint      String
  createdAt        DateTime
  updatedAt        DateTime
  reviews          JuryVerificationReview[]
  childReviews     JuryReviewResult[] @relation("VerificationChildReview")

  @@index([tenantId])
}

/// Request to re-enter jury review after verification. READY does not execute the core.
model JuryVerificationReview {
  id                   String                        @id
  tenantId             String
  tenant               JuryTenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidenceId           String
  evidence             JuryEvidence                  @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  parentReviewResultId String
  parentReviewResult   JuryReviewResult              @relation("VerificationReviewParent", fields: [parentReviewResultId], references: [id], onDelete: Restrict)
  verificationResultId String                        @unique
  verificationResult   JuryVerificationResult        @relation(fields: [verificationResultId], references: [id], onDelete: Restrict)
  decisionTaskId       String
  decisionTask         JuryDecisionTask              @relation(fields: [decisionTaskId], references: [id], onDelete: Restrict)
  type                 JuryVerificationReviewType
  status               JuryVerificationReviewStatus
  createdAt            DateTime
  updatedAt            DateTime
  executedResult       JuryReviewResult? @relation("VerificationReviewExecution")

  @@index([tenantId])
}

enum JuryDecisionCycleStatus {
  ACTIVE
  COMPLETED
  BLOCKED
  FAILED
  CANCELLED
}

/// Product decision-cycle limits. Null disables that one limit.
model JuryProductLoopPolicy {
  id                      String     @id
  tenantId                String     @unique
  tenant                  JuryTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  maxIterations           Int?
  maxVerificationAttempts Int?
  maxSameDecision         Int?
  maxSameConflict         Int?
  maxRuntimeMs            Int?
  maxCostUsd              Float?
  createdAt               DateTime
  updatedAt               DateTime
  cycles                  JuryDecisionCycle[]
}

/// Whether this tenant may enter the auto loop. Absent means off.
/// Loop-guard numbers stay on JuryProductLoopPolicy.
model JuryAutoLoopActivation {
  id        String     @id
  tenantId  String     @unique
  tenant    JuryTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled   Boolean
  /// OFF, TASK_ONLY, or FULL_AUTO. Absent or unknown stays OFF.
  mode      String     @default("OFF")
  updatedAt DateTime
  updatedBy String

  @@index([tenantId])
}

/// One decision cycle per root review. It does not create the next task.
model JuryDecisionCycle {
  id                    String                  @id
  tenantId              String
  tenant                JuryTenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rootReviewResultId    String                  @unique
  rootReviewResult      JuryReviewResult        @relation("CycleRoot", fields: [rootReviewResultId], references: [id], onDelete: Restrict)
  currentReviewResultId String
  currentReviewResult   JuryReviewResult        @relation("CycleCurrent", fields: [currentReviewResultId], references: [id], onDelete: Restrict)
  policyId              String?
  policy                JuryProductLoopPolicy?  @relation(fields: [policyId], references: [id], onDelete: Restrict)
  iteration             Int
  verificationAttempts  Int
  sameDecisionCount     Int
  sameConflictCount     Int
  decisionFingerprint   String
  conflictFingerprint   String
  status                JuryDecisionCycleStatus
  blockedReason         String?
  startedAt             DateTime
  updatedAt             DateTime

  @@index([tenantId])
}

model JuryAgentExecution {
  id               String             @id
  tenantId         String
  tenant           JuryTenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId           String
  task             JuryImprovementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent            JuryAgentKind
  allowedPaths     Json
  deniedPaths      Json
  status           JuryExecutionStatus
  startedAt        DateTime?
  finishedAt       DateTime?
  estimatedCostUsd Float?
  inputSnapshot    Json?
  workspaceRef     Json?
  requestedAt      DateTime?
  resultRef        String?
  errorCode        String?
  provenance       Json?
  createdAt        DateTime?
  updatedAt        DateTime?
  gate             JuryChangeGateResult?

  @@unique([taskId, agent])
  @@index([tenantId])
}

model JuryChangeGateResult {
  id                 String               @id
  tenantId           String
  tenant             JuryTenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executionId        String               @unique
  execution          JuryAgentExecution   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  changedFiles       Json
  riskFlags          Json
  testsPassed        Boolean?
  gate               JuryGateResult
  improvementTaskId  String?
  improvementTask    JuryImprovementTask? @relation(fields: [improvementTaskId], references: [id], onDelete: Restrict)
  status             JuryChangeGateStatus?
  addedFiles         Json?
  modifiedFiles      Json?
  deletedFiles       Json?
  blockedFiles       Json?
  riskLevel          JuryChangeRiskLevel?
  riskReasons        Json?
  testResults        Json?
  agentReportedFiles Json?
  discrepancy        Boolean?
  discrepancyReasons Json?
  diffStat           Json?
  provenance         Json?
  errorCode          String?
  credentialDetected Boolean?
  credentialType     String?
  createdAt          DateTime?
  updatedAt          DateTime?
  resolutions        JuryChangeGateResolution[]
  changeGateReview   JuryChangeGateReview?

  @@index([tenantId])
}

enum JuryChangeGateResolutionAction {
  RECHECK_REQUIRED
  MANUAL_APPROVE
  MANUAL_BLOCK
}

/// Explicit decision for a GATED change-gate result. It does not re-run the gate or an agent.
model JuryChangeGateResolution {
  id                 String                         @id
  tenantId           String
  tenant             JuryTenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changeGateResultId String
  changeGateResult   JuryChangeGateResult           @relation(fields: [changeGateResultId], references: [id], onDelete: Restrict)
  agentExecutionId   String
  improvementTaskId  String
  action             JuryChangeGateResolutionAction
  previousStatus     JuryChangeGateStatus
  resultingStatus    JuryChangeGateStatus
  reason             Json
  reasonFingerprint  String
  resolvedBy         String
  resolvedAt         DateTime
  provenance         Json
  createdAt          DateTime

  @@unique([changeGateResultId, action, reasonFingerprint], map: "JuryChangeGateResolution_gate_action_reason_key")
  @@index([tenantId])
}

enum JuryChangeGateReviewStatus {
  READY
  RUNNING
  EXECUTED
  FAILED
}

enum JuryChangeGateReviewSource {
  CHANGE_GATE
}

/// Re-review after an APPROVED change gate. Separate from verification re-review.
model JuryChangeGateReview {
  id                   String                      @id
  tenantId             String
  tenant               JuryTenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentReviewResultId String
  parentReviewResult   JuryReviewResult            @relation("ChangeGateReviewParent", fields: [parentReviewResultId], references: [id], onDelete: Restrict)
  changeGateResultId   String                      @unique
  changeGateResult     JuryChangeGateResult        @relation(fields: [changeGateResultId], references: [id], onDelete: Restrict)
  agentExecutionId     String
  improvementTaskId    String
  improvementTask      JuryImprovementTask         @relation(fields: [improvementTaskId], references: [id], onDelete: Restrict)
  evidenceId           String
  evidence             JuryEvidence                @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  sourceEvidenceId     String
  reason               Json
  status               JuryChangeGateReviewStatus
  source               JuryChangeGateReviewSource
  errorCode            String?
  reviewRequestId      String?                     @unique
  reviewResultId       String?
  provenance           Json
  createdAt            DateTime
  updatedAt            DateTime

  @@index([tenantId])
}

model JuryReReviewResult {
  id                     String              @id
  tenantId               String
  tenant                 JuryTenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taskId                 String
  task                   JuryImprovementTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  previousReviewResultId String
  nextReviewResultId     String
  resolved               Boolean
  sameProblem            Boolean
  completedAt            DateTime

  @@index([tenantId])
}

model JuryAuditEvent {
  id                 String    @id
  tenantId           String
  tenant             JuryTenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timestamp          DateTime
  actor              String
  action             String
  serviceKey         String?
  accessMethod       String?
  scopeId            String?
  source             String?
  evidenceId         String?
  reviewId           String?
  decision           String?
  improvementTaskId  String?
  agent              String?
  changedFiles       Json?
  testResult         String?
  reReviewResultId   String?
  decisionTaskId     String?
  agentExecutionId   String?
  provenance         Json?

  @@index([tenantId, timestamp])
}