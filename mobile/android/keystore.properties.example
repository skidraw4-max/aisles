# Copy to keystore.properties (gitignored) and fill in real values.
# Generate upload key once (Windows, from mobile/android):
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Play App Signing: Google holds the app signing key; you only upload with this upload key.

storeFile=upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
